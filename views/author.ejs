<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width= , initial-scale=1.0">
   <link rel="stylesheet" href="/main.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet"/>
     <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <title>portfolio</title>
</head>

<body>
    <div class="frame">
        <div class="main_frame">
            <div class="left_frame">
                <div class="left_1">
                    <div class="left_1_1">
                        <img src="images/profile.png" width="156px" height="142px" alt="--">
                    </div>
                    <div class="left_1_2">
                        <%= user.name %>
                    </div>
                    <div class="left_1_3">
                        <%= user.profession %>
                    </div>
                    <div class="left_icons">
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/facebook.svg" class="icon_1"/>
                            </div>
                        </a>  <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/x.svg" class="icon_1"/>
                            </div>
                        </a>
                          <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/youtube.svg" class="icon_1"/>
                            </div>
                        </a>
                          <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/linkedin.svg" class="icon_1"/>
                            </div>
                        </a>
                          <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/instagram.svg" class="icon_1"/>
                            </div>
                        </a>
                    </div>
                </div> 
                <div class="marginer"></div>
                <div class="line"></div>

                
                <div class="left_2">
                    <div class="about_me">
                        <div class="about_me_color">Age:</div>
                        <div><%= user.age %></div>
                    </div>

                     <div class="about_me">
                        <div class="about_me_color">Residence:</div>
                        <div><%= user.residence %></div>
                    </div>

                     <div class="about_me">
                        <div class="about_me_color">Freelance:</div>
                        <div>Available</div>
                    </div>

                     <div class="about_me">
                        <div class="about_me_color">Address:</div>
                        <div><%= user.address %></div>
                    </div>
                </div>
                <div class="marginer"></div>
                <div class="line"></div>

                <div class="left_3">
                    <div>
                        <h3>Languages</h3>
                    </div>
                    <div class="language">
                        <div class="language_1"><%=user.languages[0]%>:</div>
                        <div class="language_number">100%</div>
                    </div>

                     <div class="language">
                        <div class="language_1"><%=user.languages[1]%>:</div>
                        <div class="language_number">90%</div>
                    </div>

                     <div class="language">
                        <div class="language_1"><%=user.languages[2]%>:</div>
                        <div class="language_number">95%</div>
                    </div>
                </div>
                <div class="marginer"></div>
                <div class="line"></div>


                <div class="left_4">
                    <div class="left_3_1">
                        <h3>Skills</h3>
                    </div>
                     <div class="skills">
                        <div class="skills_1"><%=user.skills[0]%>:</div>
                        <div class="skills_number">80%</div>
                    </div>

                     <div class="skills">
                        <div class="skills_1"><%=user.skills[1]%>:</div>
                        <div class="skills_number">82%</div>
                    </div>

                     <div class="skills">
                        <div class="skills_1"><%=user.skills[2]%>:</div>
                        <div class="skills_number">88%</div>
                    </div>
                    <div class="skills">
                        <div class="skills_1"><%=user.skills[3]%>:</div>
                        <div class="skills_number">89%</div>
                    </div>
                    <div class="skills">
                        <div class="skills_1"><%=user.skills[4]%>:</div>
                        <div class="skills_number">70%</div>
                    </div>
                </div>
                <div class="marginer"></div>
                <div class="line"></div>


                <div class="left_5">
                    <div class="left_3_1">
                        <h3>Extra Skills</h3>
                    </div>
                    <div class="extra">
                        <img src="icon/Icons.svg" width="15px" height="15px">
                        <p>Bootstrap, Materialize</p>
                    </div>
                    <div class="extra">
                        <img src="icon/Icons.svg" width="15px" height="15px">
                        <p>Styling, Sass</p>
                    </div>
                    <div class="extra">
                        <img src="icon/Icons.svg" width="15px" height="15px">
                        <p>Django, Flask</p>
                    </div>
                    <div class="extra">
                        <img src="icon/Icons.svg" width="15px" height="15px">
                        <p>GIT Knowledge</p>
                    </div>
                </div>
                <div class="marginer"></div>
</div>
            

<div class="midd_frame">
    <div class="middle">
        <div class="middle_1">
         <h2> 
            (Student) | Sowftware engineer | ITchi
         </h2>

         <p>
            The Biggest Lie I Tell Myself is “I Don’t Need to Write That Down; I’ll Remember It Later.”
         </p>

         <button class="hire_me">
            Hire me <img src="icon/Vector.svg">
        </button>
        </div>

         <div class="middle_picture">
               <img src="images/image.png" alt="image">
         </div>
    </div>
    <div class="my_services">
        <h2>
            My Services
        </h2>
        <p>
        If you are going to use a passage of Lorem Ipsum, you need to be sure there isn't anything embarrassing hidden in the middle of text.
        </p>
             <div class="cards">
                <div class="card">
                    <img src="box images/coding.svg" >
                    <h3>Web Development</h3>
                    <p>Blog, E-Commerce</p>
                </div>
                <div class="card">
                    <img src="box images/ill.svg" >
                    <h3>UI/UX Design</h3>
                    <p>Mobile App, Website Design</p>
                </div>
                 <div class="card">
                    <img src="box images/mic.svg" >
                    <h3>Sound Design</h3>
                    <p>Voice Over, Beat Making</p>
                </div>
                 <div class="card">
                    <img src="box images/game.svg" >
                    <h3>Game Design</h3>
                    <p>Character Design, Props & Objects</p>
                </div>
                <div class="card">
                    <img src="box images/photo.svg" >
                    <h3>Photography</h3>
                    <p>Portrait, Product Photography</p>
                </div>
                <div class="advertising">
                    <h4>Advertising</h4>
                    <p>
                        here are many variations of passages of Lorem Ipsum available, but the majority have suffered alteration in some form, 
                    </p>
                    <a href="#">ORDER NOW</a>
                </div>
                    </div>

    </div>
</div>
            
<div class="right_frame">
    <div class="right_buttons">
         <button class="menu_btn"><img src="btn_icon/home.svg"></button>
        <button class="menu_btn"><img src="btn_icon/cv.svg"></button>
        <button class="menu_btn"><img src="btn_icon/portfolio.svg"></button>
        <button class="menu_btn"><img src="btn_icon/blog.svg"></button>
        <button class="menu_btn"><img src="btn_icon/contact.svg"></button>
    </div>
</div>
        </div>
    </div>
    

</body>



</html>